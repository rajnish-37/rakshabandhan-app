{
  "name": "rakshabandhan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Trusted backend for the Raksha Bandhan invitation and authentication flow",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
