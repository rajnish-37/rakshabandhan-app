    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "firebase-admin": "^13.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
